{
  "name": "example",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "env -u NO_COLOR expo start -d",
    "ios": "env -u NO_COLOR expo run:ios",
    "android": "bun run android:assemble && env -u NO_COLOR expo run:android --binary android/app/build/outputs/apk/debug/app-debug.apk",
    "doctor": "env -u NO_COLOR bunx expo-doctor@1.21.5",
    "install-check": "env -u NO_COLOR bunx expo install --check",
    "config:introspect": "env -u NO_COLOR bunx expo config --type introspect --json > /tmp/nitro-storage-expo-config.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prebuild": "env -u NO_COLOR expo prebuild",
    "prebuild:clean": "env -u NO_COLOR expo prebuild --clean",
    "lint": "bunx eslint app components --max-warnings=0",
    "lint:fix": "bunx eslint app components --max-warnings=0 --fix",
    "android:assemble": "cd android && NODE_ENV=development ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} ANDROID_SDK_ROOT=${ANDROID_SDK_ROOT:-${ANDROID_HOME:-$HOME/Library/Android/sdk}} ./gradlew --no-daemon --no-configuration-cache -PreactNativeArchitectures=arm64-v8a :app:assembleDebug",
    "ios:build": "cd ios && pod install && xcodebuild -workspace NitroStorage.xcworkspace -scheme NitroStorage -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' build"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.10",
    "expo": "~58.0.16",
    "expo-asset": "~58.0.17",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-nitro-storage": "workspace:*",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.18"
  }
}
