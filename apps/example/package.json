{
  "name": "example",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "env -u NO_COLOR expo start -d",
    "ios": "env -u NO_COLOR expo run:ios",
    "android": "env -u NO_COLOR expo run:android",
    "doctor": "env -u NO_COLOR bunx expo-doctor",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prebuild": "env -u NO_COLOR expo prebuild",
    "prebuild:clean": "env -u NO_COLOR expo prebuild --clean",
    "lint": "bunx eslint app components --max-warnings=0",
    "lint:fix": "bunx eslint app components --max-warnings=0 --fix",
    "android:assemble": "cd android && NODE_ENV=development ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} ANDROID_SDK_ROOT=${ANDROID_SDK_ROOT:-${ANDROID_HOME:-$HOME/Library/Android/sdk}} ./gradlew --no-daemon -PreactNativeArchitectures=arm64-v8a :app:assembleDebug",
    "ios:build": "cd ios && pod install && xcodebuild -workspace NitroStorage.xcworkspace -scheme NitroStorage -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "expo": "~56.0.9",
    "expo-asset": "~56.0.16",
    "expo-build-properties": "~56.0.17",
    "expo-constants": "~56.0.17",
    "expo-font": "~56.0.5",
    "expo-linking": "~56.0.13",
    "expo-router": "~56.2.9",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-nitro-modules": "0.35.7",
    "react-native-nitro-storage": "*",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.2.14",
    "babel-preset-expo": "~56.0.0"
  }
}
