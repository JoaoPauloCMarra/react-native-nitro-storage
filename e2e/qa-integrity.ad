open "com.nitrostorage.example" "nitrostorage://e2e-integrity" --relaunch
wait "stable"
wait id="e2e-integrity-screen"
wait id="e2e-integrity-ready"
wait text "ready"
wait id="e2e-integrity-finished"
wait text "finished"
wait id="e2e-integrity-summary"
wait text "finished:fail=0:skip=0"
wait id="e2e-integrity-native-backend-capabilities"
wait text "pass:native:disk=sqlite:secure=platform-secure-storage"
wait id="e2e-integrity-audit-prefix-case"
wait text "pass:exact-case=upper-only:lower=preserved"
wait id="e2e-integrity-audit-memory-raw-and-set"
wait text "pass:raw-literal=preserved:set=3"
wait id="e2e-integrity-audit-prefix-literals"
wait text "pass:literal-prefixes=5"
wait id="e2e-integrity-audit-nul-roundtrip"
wait text "pass:disk+secure:nul+unicode+batch"
wait id="e2e-integrity-disk-write-read"
wait text "pass:raw=disk-ok:item=disk-item-ok"
wait id="e2e-integrity-secure-write-read"
wait text "pass:secure-ok"
wait id="e2e-integrity-import-then-flush"
wait text "pass:imported-after-flush"
wait id="e2e-integrity-tx-rollback"
wait text "pass:committed:rollback=true"
wait id="e2e-integrity-renameFrom"
wait text "pass:migrated-value:legacy=missing"
wait id="e2e-integrity-namespace-isolation"
wait text "pass:item=ns-ok:raw=ns-raw:plain-key=isolated"
wait id="e2e-integrity-cache-metrics"
wait text "pass:cache=miss-hit-entry"
wait id="e2e-integrity-disk-ttl"
wait text "pass:expired-default"
wait id="e2e-integrity-secure-batch"
wait text "pass:a,b"
wait id="e2e-integrity-secure-tx-rollback"
wait text "pass:committed:rollback=true"
wait id="e2e-integrity-disk-prefix"
wait text "pass:keep=1:drop=missing"
wait id="e2e-integrity-async-transaction-guard"
wait text "pass:memory+disk+secure:promise-rejected:rollback=original:context=closed"
wait id="e2e-integrity-qa-key-cleanup"
wait text "pass:qa-keys=cleared"
close
