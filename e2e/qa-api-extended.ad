open "com.nitrostorage.example" "nitrostorage://e2e-api-extended" --relaunch
wait "stable"
wait id="e2e-api-extended-screen"
wait id="e2e-ext-finished"
wait text "finished"
wait id="e2e-ext-results"
wait text "ok:merge=clicks-1:setOrDelete=missing;"
wait text "ok:toggle=false,true:values=blue;"
wait text "ok:clearGroup=2:outside=kept;"
wait text "ok:onExpired=1:subscribeExpired=1;"
wait text "ok:metadata=2:export=2;"
wait text "ok:access=after-first-unlock:value=ac-ok;"
wait text "ok:coalesced=read-before-flush:flushed;"
wait text "ok:invalid_key;"
wait text "ok:scoped=disk+secure;"
wait text "ok:op=set:source=native;"
wait text "ok:auth-ttl=expired-default;"
wait text "passcode-acl="
wait text "ok:hooks=value,selector,setter,actions;"
close
