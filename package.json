{
  "name": "react-native-nitro-storage-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.js",
    "publish-package": "node scripts/publish.js",
    "publish-package:dry-run": "node scripts/publish.js --dry-run --skip-checks --yes",
    "publish-package:dry": "node scripts/publish.js --dry-run --skip-checks --yes",
    "dev": "bun run example:start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:check": "turbo run lint:check",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "clean": "turbo run clean",
    "codegen": "turbo run codegen",
    "typecheck": "turbo run typecheck",
    "test:types": "turbo run test:types --filter=react-native-nitro-storage",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage --filter=react-native-nitro-storage",
    "benchmark": "turbo run benchmark --filter=react-native-nitro-storage",
    "test:cpp": "turbo run test:cpp --filter=react-native-nitro-storage",
    "test:cpp:asan": "turbo run test:cpp:asan --filter=react-native-nitro-storage",
    "test:cpp:coverage": "turbo run test:cpp:coverage --filter=react-native-nitro-storage",
    "test:cpp:tsan": "turbo run test:cpp:tsan --filter=react-native-nitro-storage",
    "test:cpp:ubsan": "turbo run test:cpp:ubsan --filter=react-native-nitro-storage",
    "check": "bun run lint:check -- --filter=react-native-nitro-storage && bun run format:check -- --filter=react-native-nitro-storage && bun run typecheck -- --filter=react-native-nitro-storage && bun run test:types -- --filter=react-native-nitro-storage && bun run test -- --filter=react-native-nitro-storage && bun run test:cpp -- --filter=react-native-nitro-storage",
    "check:ci": "bun run check && bun run benchmark -- --filter=react-native-nitro-storage",
    "audit:package": "bun run --cwd packages/react-native-nitro-storage check:pack && bun pm pack --cwd packages/react-native-nitro-storage --dry-run",
    "release:preflight": "bun run check:ci && bun run example:check && bun run audit:package && bun run publish-package:dry-run",
    "example:start": "bun run --cwd apps/example start",
    "example:ios": "bun run --cwd apps/example ios",
    "example:android": "bun run --cwd apps/example android",
    "example:doctor": "bun run --cwd apps/example doctor",
    "example:lint": "bun run --cwd apps/example lint",
    "example:typecheck": "bun run --cwd apps/example typecheck",
    "example:check": "bun run example:doctor && bun run example:lint && bun run example:typecheck",
    "example:prebuild": "bun run --cwd apps/example prebuild",
    "example:prebuild:clean": "bun run --cwd apps/example prebuild:clean",
    "example:android:assemble": "bun run --cwd apps/example android:assemble",
    "example:ios:build": "bun run --cwd apps/example ios:build",
    "example:smoke": "bunx maestro test maestro/smoke-tests.yaml"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.85.3",
    "@swc/core": "^1.15.40",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.7.0",
    "eslint-config-expo-magic": "^2.4.0",
    "jest": "30.3.0",
    "nitrogen": "0.35.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.41.0",
    "react-native-nitro-modules": "0.35.7",
    "react-test-renderer": "19.2.3",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "turbo": "^2.9.14",
    "typescript": "6.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-nitro-modules": "0.35.7",
    "@types/react": "~19.2.14",
    "expo": "~56.0.9",
    "react-native-screens": "4.25.2",
    "expo-constants": "~56.0.17",
    "expo-linking": "~56.0.13"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "@swc/core",
    "unrs-resolver"
  ]
}
