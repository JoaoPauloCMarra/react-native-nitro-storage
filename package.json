{
  "name": "react-native-nitro-storage-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bun scripts/setup.js",
    "publish-package": "bun scripts/publish.js",
    "publish-package:dry-run": "bun scripts/publish.js --dry-run --skip-checks --yes",
    "dev": "bun run example:start",
    "build": "bun run --cwd packages/react-native-nitro-storage build",
    "lint": "bun run --cwd packages/react-native-nitro-storage lint",
    "lint:fix": "bun run --cwd packages/react-native-nitro-storage lint:fix",
    "lint:check": "bun run --cwd packages/react-native-nitro-storage lint:check",
    "format": "bun run --cwd packages/react-native-nitro-storage format",
    "format:check": "bun run --cwd packages/react-native-nitro-storage format:check",
    "clean": "bun run --cwd packages/react-native-nitro-storage clean",
    "codegen": "bun run --cwd packages/react-native-nitro-storage codegen",
    "typecheck": "bun run --cwd packages/react-native-nitro-storage typecheck",
    "test:types": "bun run --cwd packages/react-native-nitro-storage test:types",
    "test": "bun run --cwd packages/react-native-nitro-storage test",
    "test:coverage": "bun run --cwd packages/react-native-nitro-storage test:coverage",
    "benchmark": "bun run build && bun run --cwd packages/react-native-nitro-storage benchmark",
    "test:cpp": "bun run --cwd packages/react-native-nitro-storage test:cpp",
    "test:cpp:asan": "bun run --cwd packages/react-native-nitro-storage test:cpp:asan",
    "test:cpp:coverage": "bun run --cwd packages/react-native-nitro-storage test:cpp:coverage",
    "test:cpp:tsan": "bun run --cwd packages/react-native-nitro-storage test:cpp:tsan",
    "test:cpp:ubsan": "bun run --cwd packages/react-native-nitro-storage test:cpp:ubsan",
    "check": "bun run lint:check && bun run format:check && bun run typecheck && bun run test:types && bun run test && bun run test:cpp",
    "check:ci": "bun run check && bun run benchmark",
    "audit:package": "bun run codegen && bun run build && bun run --cwd packages/react-native-nitro-storage check:pack && bun pm pack --cwd packages/react-native-nitro-storage --dry-run",
    "release:preflight": "bun run check:ci && bun run example:check && bun run audit:package && bun run publish-package:dry-run",
    "example:start": "bun run --cwd apps/example start",
    "example:ios": "bun run --cwd apps/example ios",
    "example:android": "bun run --cwd apps/example android",
    "example:doctor": "bun run --cwd apps/example doctor",
    "example:lint": "bun run --cwd apps/example lint",
    "example:typecheck": "bun run --cwd apps/example typecheck",
    "example:check": "bun run example:doctor && bun run example:lint && bun run example:typecheck",
    "example:prebuild": "bun run --cwd apps/example prebuild",
    "example:prebuild:clean": "bun run --cwd apps/example prebuild:clean",
    "example:android:assemble": "bun run --cwd apps/example android:assemble",
    "example:ios:build": "bun run --cwd apps/example ios:build",
    "example:smoke": "bunx maestro test maestro/smoke-tests.yaml"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.85.3",
    "@swc/core": "^1.15.40",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.7.0",
    "eslint-config-expo-magic": "^2.4.0",
    "jest": "30.3.0",
    "nitrogen": "0.35.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.41.0",
    "react-native-nitro-modules": "0.35.7",
    "react-test-renderer": "19.2.3",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "typescript": "6.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-nitro-modules": "0.35.7",
    "@types/react": "~19.2.14",
    "expo": "~56.0.11",
    "react-native-screens": "4.25.2",
    "expo-constants": "~56.0.18",
    "expo-linking": "~56.0.14"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "@swc/core",
    "unrs-resolver"
  ]
}
